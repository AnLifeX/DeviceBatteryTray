<ui:FluentWindow x:Class="DeviceBatteryTray.Setup.WizardWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="700" Height="480" ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" ShowMaximize="False" CanMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon x:Name="TitleIcon" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：图标、名称、版本、步骤 -->
            <StackPanel Grid.Column="0" Margin="28,12,12,0">
                <Image x:Name="Logo" Width="56" Height="56" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="设备电量" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,0"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="VersionText" FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel x:Name="StepList" Margin="0,30,0,0" />
            </StackPanel>

            <!-- 右侧：页面 -->
            <Border Grid.Column="1" Margin="0,0,20,0" Padding="32,24,32,20" CornerRadius="12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <!-- 安装：欢迎 -->
                    <StackPanel x:Name="PageWelcome" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="欢迎安装设备电量" />
                        <TextBlock Style="{StaticResource Body}" Text="在任务栏显示无线键盘、鼠标、手柄的电量。" />
                        <ui:InfoBar x:Name="WelcomeInfo" Margin="0,8,0,0" IsClosable="False" />
                    </StackPanel>

                    <!-- 安装：位置 -->
                    <StackPanel x:Name="PageLocation" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="选择安装位置" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="DirBox" />
                            <ui:Button x:Name="BrowseButton" Grid.Column="1" Content="浏览…" Margin="8,0,0,0" MinWidth="0" Padding="14,7" />
                        </Grid>
                        <TextBlock x:Name="SizeText" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                        <TextBlock x:Name="UpgradeNote" Style="{StaticResource Hint}" Visibility="Collapsed"
                                   Text="已安装在此位置，将覆盖升级。" />
                        <ui:InfoBar x:Name="LocationError" Margin="0,8,0,0" Severity="Error" Title="无法安装到此位置" IsClosable="False" />
                    </StackPanel>

                    <!-- 安装：附加选项 -->
                    <StackPanel x:Name="PageOptions" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="选择附加选项" />
                        <CheckBox x:Name="DesktopBox" Content="创建桌面快捷方式" Margin="0,0,0,6" />
                        <CheckBox x:Name="AutoStartBox" Content="开机自动启动" />
                        <ui:InfoBar x:Name="RuntimeInfo" Margin="0,12,0,0" Severity="Informational" IsClosable="False"
                                    Title="需要 .NET 8 桌面运行时"
                                    Message="将从微软官网下载并安装（约 56 MB），需要管理员权限。" />
                    </StackPanel>

                    <!-- 卸载：确认 -->
                    <StackPanel x:Name="PageConfirm" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="卸载设备电量" />
                        <TextBlock x:Name="ConfirmText" Style="{StaticResource Body}" />
                        <TextBlock x:Name="ConfirmDir" Style="{StaticResource Hint}" />
                        <CheckBox x:Name="KeepDataBox" Margin="0,10,0,0" Content="保留设置和日志" />
                    </StackPanel>

                    <!-- 进度 -->
                    <StackPanel x:Name="PageProgress" Visibility="Collapsed">
                        <TextBlock x:Name="ProgressTitle" Style="{StaticResource PageTitle}" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" />
                        <ProgressBar x:Name="Bar" Maximum="100" Margin="0,6,0,0" />
                        <ui:InfoBar x:Name="ErrorInfo" Margin="0,16,0,0" Severity="Error" IsClosable="False" />
                    </StackPanel>

                    <!-- 完成 -->
                    <StackPanel x:Name="PageDone" Visibility="Collapsed">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" Filled="True" FontSize="44" HorizontalAlignment="Left" Margin="0,0,0,12"
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                        <TextBlock x:Name="DoneTitle" Style="{StaticResource PageTitle}" />
                        <CheckBox x:Name="LaunchBox" Content="启动设备电量" IsChecked="True" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,20,18">
            <ui:Button x:Name="BackButton" Content="上一步" />
            <ui:Button x:Name="NextButton" Content="下一步" Appearance="Primary" Margin="8,0,0,0" />
            <ui:Button x:Name="CancelButton" Content="取消" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
