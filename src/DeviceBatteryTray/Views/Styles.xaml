<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:local="clr-namespace:DeviceBatteryTray.Views">
    <!-- WPF-UI 默认控件圆角 4px，高分屏上看着接近直角；这里统一放大：卡片 12px，按钮 / 输入框 6px。
         （暗色主题下卡片边缘对比度很低，8px 看起来只有 5px 左右，所以卡片用得更大）
         WPF-UI 模板里用的是 StaticResource，覆盖资源键无效：有 CornerRadius 属性的直接设，
         没有的用 local:Corners.Radius 在模板加载后替换。 -->
    <CornerRadius x:Key="AppControlRadius">6</CornerRadius>
    <CornerRadius x:Key="AppCardRadius">12</CornerRadius>

    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="CornerRadius" Value="{StaticResource AppControlRadius}" />
    </Style>
    <Style TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
        <Setter Property="CornerRadius" Value="{StaticResource AppCardRadius}" />
    </Style>
    <Style TargetType="ui:CardAction" BasedOn="{StaticResource {x:Type ui:CardAction}}">
        <Setter Property="local:Corners.Radius" Value="12" />
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="local:Corners.Radius" Value="6" />
    </Style>
    <Style TargetType="ui:NumberBox" BasedOn="{StaticResource {x:Type ui:NumberBox}}">
        <Setter Property="local:Corners.Radius" Value="6" />
    </Style>
    <Style TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
        <Setter Property="local:Corners.Radius" Value="6" />
    </Style>
</ResourceDictionary>
