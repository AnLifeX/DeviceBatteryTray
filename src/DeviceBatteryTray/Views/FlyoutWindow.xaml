<Window x:Class="DeviceBatteryTray.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:DeviceBatteryTray.Views"
        Title="设备电量面板"
        Width="392" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        Opacity="0">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 电池图标：充电绿色 + 中间闪电，偏低黄、低电量红，正常为中性色（与任务栏一致） -->
        <Style x:Key="BatteryIcon" TargetType="local:BatteryGlyph">
            <Setter Property="Stroke" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Fill" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Bolt" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Charging">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Caution">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Critical">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowPercent" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Critical">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 面板里所有按钮：透明底，悬停 / 按下有背景色，按下时轻微缩小（80ms），松开回弹（150ms） -->
        <Style x:Key="FlyoutButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MouseOverBackground" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="MouseOverBorderBrush" Value="Transparent" />
            <Setter Property="PressedBackground" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
            <Setter Property="PressedBorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.97" Duration="0:0:0.08" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.97" Duration="0:0:0.08" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FooterButton" TargetType="ui:Button" BasedOn="{StaticResource FlyoutButton}">
            <Setter Property="Padding" Value="10,7" />
        </Style>
    </Window.Resources>

    <!-- 四周 16px 留给阴影；圆角、边框、阴影与 ChromeWindow（Win10 主页面）一致 -->
    <Border x:Name="Card" Margin="16" CornerRadius="8" BorderThickness="1"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="3" Direction="270" Opacity="0.28" />
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 + 更新时间 + 刷新 -->
            <Grid Grid.Row="0" Margin="18,14,10,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock FontTypography="BodyStrong" Text="设备电量" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Border Visibility="{Binding Demo, Converter={StaticResource BoolToVis}}" Margin="8,0,0,0" Padding="6,1" CornerRadius="4"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
                            <TextBlock Text="演示" FontSize="11" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                    </StackPanel>
                    <ui:TextBlock FontTypography="Caption" Text="{Binding FlyoutUpdatedText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ui:Button Style="{StaticResource FlyoutButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding RefreshCommand}"
                           Padding="8" ToolTip="刷新">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" RenderTransformOrigin="0.5,0.5">
                        <ui:SymbolIcon.RenderTransform>
                            <RotateTransform />
                        </ui:SymbolIcon.RenderTransform>
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Spinning}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="Spin">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="Spin" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </ui:Button>
            </Grid>

            <!-- 新版本 -->
            <ui:Button Grid.Row="1" Style="{StaticResource FlyoutButton}" Margin="12,0,12,6" Padding="12,9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                       Command="{Binding OpenSettingsCommand}" Visibility="{Binding UpdateBannerOpen, Converter={StaticResource BoolToVis}}"
                       Background="{DynamicResource AccentSubtleBackgroundBrush}" MouseOverBackground="{DynamicResource AccentSubtleBackgroundHoverBrush}"
                       PressedBackground="{DynamicResource AccentSubtleBackgroundHoverBrush}" BorderThickness="0">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <ui:TextBlock Text="{Binding FlyoutUpdateText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ui:TextBlock Text="查看" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </Grid>
            </ui:Button>

            <!-- 在线设备 -->
            <StackPanel Grid.Row="2" Margin="6,0,6,8">
                <!-- 设备多时限高滚动，面板不会超出屏幕 -->
                <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding OnlineDevices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:DeviceItem}">
                            <ui:Button Style="{StaticResource FlyoutButton}" Padding="12,6" Margin="0,1"
                                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                       Command="{Binding DataContext.OpenMainCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Grid MinHeight="38"><!-- 每行等高，不管有没有「充电中」之类的备注 -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="58" />
                                    </Grid.ColumnDefinitions>
                                    <ui:FontIcon Glyph="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <ui:TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <local:BatteryGlyph Grid.Column="2" Style="{StaticResource BatteryIcon}" Percent="{Binding Percent}" Charging="{Binding Charging}" Width="28" Height="14" Margin="4,0,0,0" />
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowPercent}" Text="{Binding PercentText}" TextAlignment="Right" />
                                        <ui:TextBlock FontTypography="Caption" Text="{Binding Note}" TextAlignment="Right"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <ui:TextBlock.Style>
                                                <Style TargetType="ui:TextBlock">
                                                    <Style.Triggers>
                                                        <!-- 没有备注时不占高度，百分比才能和名称居中对齐 -->
                                                        <DataTrigger Binding="{Binding Note}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:TextBlock.Style>
                                        </ui:TextBlock>
                                    </StackPanel>
                                </Grid>
                            </ui:Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>

                <!-- 空状态 -->
                <StackPanel Visibility="{Binding NoOnlineDevices, Converter={StaticResource BoolToVis}}" Margin="0,14,0,10">
                    <ui:SymbolIcon Symbol="PlugDisconnected24" FontSize="28" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ui:TextBlock Text="没有要显示的设备" HorizontalAlignment="Center" Margin="0,8,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:HyperlinkButton Content="打开主页面" HorizontalAlignment="Center" Command="{Binding OpenMainCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- 底栏 -->
            <Border Grid.Row="3" CornerRadius="0,0,7,7" Padding="8,6" BorderThickness="0,1,0,0"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Style="{StaticResource FooterButton}" Command="{Binding OpenMainCommand}" Icon="{ui:SymbolIcon Home24}" Content="主页面" />
                        <ui:Button Style="{StaticResource FooterButton}" Command="{Binding OpenSettingsCommand}" Icon="{ui:SymbolIcon Settings24}" Content="设置" Margin="2,0,0,0" />
                    </StackPanel>
                    <ui:Button Style="{StaticResource FooterButton}" Command="{Binding ExitCommand}" Icon="{ui:SymbolIcon Power24}" Content="退出" HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
