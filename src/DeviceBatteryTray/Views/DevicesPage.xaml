<UserControl x:Class="DeviceBatteryTray.Views.DevicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:DeviceBatteryTray.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 卡片进场：淡入 + 上移 8px -->
        <Storyboard x:Key="CardEnter">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="8" To="0" Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 电量条颜色 -->
        <Style x:Key="BatteryBar" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Caution">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Critical">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Charging">
                    <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PercentText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Critical">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,24">
            <!-- 标题 + 更新时间 + 刷新 -->
            <Grid Margin="0,4,0,20">
                <ui:TextBlock FontTypography="Title" Text="设备" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:TextBlock Text="{Binding UpdatedText}" VerticalAlignment="Center" Margin="0,0,8,0"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:Button Command="{Binding RefreshCommand}" Appearance="Transparent" Padding="8" ToolTip="刷新" Margin="0,0,4,0">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="18" RenderTransformOrigin="0.5,0.5">
                            <ui:SymbolIcon.RenderTransform>
                                <RotateTransform x:Name="SpinTransform" />
                            </ui:SymbolIcon.RenderTransform>
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Spinning}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="Spin">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="Spin" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </ui:Button>
                    <ui:Button Command="{Binding ShowSettingsCommand}" Appearance="Transparent" Padding="8" ToolTip="设置">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="18" />
                    </ui:Button>
                </StackPanel>
            </Grid>

            <!-- 新版本提示 -->
            <Border Visibility="{Binding UpdateBannerOpen, Converter={StaticResource BoolToVis}}" CornerRadius="8" Padding="16,12" Margin="0,0,0,12"
                    Background="{DynamicResource InfoBarInformationalSeverityBackgroundBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding UpdateBannerTitle}" />
                        <ui:TextBlock FontTypography="Caption" Text="{Binding UpdateBannerMessage}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" Content="立即更新" Appearance="Primary" Command="{Binding ApplyUpdateCommand}"
                               Visibility="{Binding CanApplyUpdate, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>

            <!-- 设备卡片 -->
            <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:DeviceItem}">
                        <ui:CardControl Margin="0,0,0,6" Padding="18,14" Opacity="0">
                            <ui:CardControl.RenderTransform>
                                <TranslateTransform />
                            </ui:CardControl.RenderTransform>
                            <ui:CardControl.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource CardEnter}" />
                                </EventTrigger>
                            </ui:CardControl.Triggers>
                            <ui:CardControl.Icon>
                                <ui:FontIcon Glyph="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="24" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" />
                                    <ui:TextBlock FontTypography="Caption" Text="{Binding Status}" Margin="0,2,0,0"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <Grid>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding Online, Converter={StaticResource BoolToVis}}">
                                    <ProgressBar Style="{StaticResource BatteryBar}" Value="{Binding Percent, Mode=OneWay}" Maximum="100"
                                                 Width="150" Height="4" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource PercentText}" Text="{Binding PercentText}"
                                               Width="64" TextAlignment="Right" VerticalAlignment="Center" />
                                </StackPanel>
                                <ui:Button Content="以管理员身份重启" Icon="{ui:SymbolIcon ShieldKeyhole24}"
                                           Command="{Binding DataContext.ElevateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVis}}" />
                                <ui:TextBlock Text="{Binding StateText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                              VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </ui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 空状态 -->
            <Border Visibility="{Binding NoDevices, Converter={StaticResource BoolToVis}}" CornerRadius="8" Padding="24,40"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="PlugDisconnected24" FontSize="40" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ui:TextBlock FontTypography="BodyStrong" Text="没有检测到设备" HorizontalAlignment="Center" Margin="0,14,0,4" />
                    <ui:TextBlock Text="插入支持的接收器后会自动出现" HorizontalAlignment="Center"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock FontTypography="Caption" Text="{Binding SupportedText}" HorizontalAlignment="Center" TextWrapping="Wrap"
                                  TextAlignment="Center" Margin="0,16,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Border>
            <ui:ProgressRing IsIndeterminate="True" Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}" Margin="0,40" />

            <ui:TextBlock FontTypography="Caption" Margin="2,10,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                          Visibility="{Binding HasDevices, Converter={StaticResource BoolToVis}}"
                          Text="任务栏只显示在线的设备；休眠的设备唤醒后，下次刷新会自动出现。" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
