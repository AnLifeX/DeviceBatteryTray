<UserControl x:Class="DeviceBatteryTray.Views.DevicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:DeviceBatteryTray.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisConverter x:Key="InverseBoolToVis" />

        <!-- 卡片进场：淡入 + 上移 8px -->
        <Storyboard x:Key="CardEnter">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="8" To="0" Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="PercentText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Critical">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 电池图标：充电绿色 + 中间闪电，偏低黄、低电量红，正常为中性色（与任务栏一致） -->
        <Style x:Key="BatteryIcon" TargetType="local:BatteryGlyph">
            <Setter Property="Stroke" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Fill" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Bolt" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Charging">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Caution">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Critical">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 固定标题栏：标题 + 更新时间 + 刷新 / 主题 / 关于 / 设置 -->
        <Grid Grid.Row="0" Margin="0,4,14,16">
            <ui:TextBlock FontTypography="Title" Text="设备" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:TextBlock Text="{Binding UpdatedText}" VerticalAlignment="Center" Margin="0,0,6,0"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:Button Style="{StaticResource HeaderButton}" Command="{Binding RefreshCommand}" ToolTip="刷新">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="18" RenderTransformOrigin="0.5,0.5">
                        <ui:SymbolIcon.RenderTransform>
                            <RotateTransform />
                        </ui:SymbolIcon.RenderTransform>
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Spinning}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="Spin">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="Spin" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </ui:Button>
                <ui:DropDownButton Appearance="Transparent" Padding="8" Margin="4,0,0,0" ToolTip="主题">
                    <ui:DropDownButton.Content>
                        <ui:SymbolIcon Symbol="{Binding ThemeSymbol}" FontSize="18" />
                    </ui:DropDownButton.Content>
                    <ui:DropDownButton.Flyout>
                        <ContextMenu>
                            <MenuItem Header="跟随系统" Command="{Binding ThemeSystemCommand}" IsCheckable="False" IsChecked="{Binding ThemeIsSystem, Mode=OneWay}" />
                            <MenuItem Header="浅色" Command="{Binding ThemeLightCommand}" IsCheckable="False" IsChecked="{Binding ThemeIsLight, Mode=OneWay}" />
                            <MenuItem Header="深色" Command="{Binding ThemeDarkCommand}" IsCheckable="False" IsChecked="{Binding ThemeIsDark, Mode=OneWay}" />
                        </ContextMenu>
                    </ui:DropDownButton.Flyout>
                </ui:DropDownButton>
                <ui:Button Style="{StaticResource HeaderButton}" Command="{Binding ShowAboutCommand}" ToolTip="关于">
                    <ui:SymbolIcon Symbol="Info24" FontSize="18" />
                </ui:Button>
                <ui:Button Style="{StaticResource HeaderButton}" Command="{Binding ShowSettingsCommand}" ToolTip="设置">
                    <ui:SymbolIcon Symbol="Settings24" FontSize="18" />
                </ui:Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,14,24">
                <!-- 演示模式提示 -->
                <Border Visibility="{Binding Demo, Converter={StaticResource BoolToVis}}" CornerRadius="8" Padding="16,12" Margin="0,0,0,12"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Info24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                            <ui:TextBlock FontTypography="BodyStrong" Text="演示模式" />
                            <ui:TextBlock FontTypography="Caption" Text="显示的是模拟设备，任务栏电量条和弹出面板也一样；不会弹低电量提醒" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:Button Grid.Column="2" Content="退出演示" Command="{Binding ExitDemoCommand}" />
                    </Grid>
                </Border>

                <!-- 新版本提示 -->
                <Border Visibility="{Binding UpdateBannerOpen, Converter={StaticResource BoolToVis}}" CornerRadius="8" Padding="16,12" Margin="0,0,0,12"
                        Background="{DynamicResource InfoBarInformationalSeverityBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding UpdateBannerTitle}" />
                            <ui:TextBlock FontTypography="Caption" Text="{Binding UpdateBannerMessage}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:Button Grid.Column="2" Content="立即更新" Appearance="Primary" Command="{Binding ApplyUpdateCommand}"
                                   Visibility="{Binding CanApplyUpdate, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>

                <!-- 设备卡片 -->
                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:DeviceItem}">
                            <ui:CardControl Margin="0,0,0,6" Padding="18,12" Opacity="0">
                                <ui:CardControl.RenderTransform>
                                    <TranslateTransform />
                                </ui:CardControl.RenderTransform>
                                <ui:CardControl.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard Storyboard="{StaticResource CardEnter}" />
                                    </EventTrigger>
                                </ui:CardControl.Triggers>
                                <ui:CardControl.Icon>
                                    <ui:FontIcon Glyph="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="24" />
                                </ui:CardControl.Icon>
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <!-- 隐藏的设备整体变淡 -->
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Visible}" Value="False">
                                                        <Setter Property="Opacity" Value="0.5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <!-- 名称：点铅笔就地编辑，回车保存，Esc 取消 -->
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" VerticalAlignment="Center"
                                                          Visibility="{Binding Editing, Converter={StaticResource InverseBoolToVis}}" />
                                            <ui:Button Command="{Binding RenameCommand}" Appearance="Transparent" BorderThickness="0" Padding="4" Margin="6,0,0,0"
                                                       ToolTip="重命名" Visibility="{Binding Editing, Converter={StaticResource InverseBoolToVis}}">
                                                <ui:SymbolIcon Symbol="Edit24" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </ui:Button>
                                            <ui:TextBox x:Name="NameBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" MinWidth="220"
                                                        PlaceholderText="留空恢复默认名称" ClearButtonEnabled="False"
                                                        Visibility="{Binding Editing, Converter={StaticResource BoolToVis}}"
                                                        IsVisibleChanged="NameBox_IsVisibleChanged" LostKeyboardFocus="NameBox_LostFocus">
                                                <ui:TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding CommitRenameCommand}" />
                                                    <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                                                </ui:TextBox.InputBindings>
                                            </ui:TextBox>
                                        </StackPanel>
                                        <ui:TextBlock FontTypography="Caption" Text="{Binding Status}" Margin="0,2,0,0"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Grid MinWidth="110">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding Online, Converter={StaticResource BoolToVis}}">
                                            <local:BatteryGlyph Style="{StaticResource BatteryIcon}" Percent="{Binding Percent}" Charging="{Binding Charging}" Width="34" Height="17" />
                                            <TextBlock Style="{StaticResource PercentText}" Text="{Binding PercentText}"
                                                       Width="64" TextAlignment="Right" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ui:Button Content="以管理员身份重启" Icon="{ui:SymbolIcon ShieldKeyhole24}"
                                                   Command="{Binding DataContext.ElevateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVis}}" />
                                        <ui:TextBlock Text="{Binding StateText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </Grid>
                                    <!-- 显示开关：关掉后不在任务栏和弹出面板显示 -->
                                    <Border Width="1" Margin="18,6" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                    <ui:ToggleSwitch IsChecked="{Binding Visible}" VerticalAlignment="Center" ToolTip="在任务栏和弹出面板中显示" />
                                </StackPanel>
                            </ui:CardControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 空状态 -->
                <Border Visibility="{Binding NoDevices, Converter={StaticResource BoolToVis}}" CornerRadius="8" Padding="24,40"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="PlugDisconnected24" FontSize="40" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <ui:TextBlock FontTypography="BodyStrong" Text="没有检测到设备" HorizontalAlignment="Center" Margin="0,14,0,4" />
                        <ui:TextBlock Text="插入支持的接收器后会自动出现" HorizontalAlignment="Center"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:TextBlock FontTypography="Caption" Text="{Binding SupportedText}" HorizontalAlignment="Center" TextWrapping="Wrap"
                                      TextAlignment="Center" Margin="0,16,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>
                <ui:ProgressRing IsIndeterminate="True" Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}" Margin="0,40" />

                <ui:TextBlock FontTypography="Caption" Margin="2,10,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"
                              Visibility="{Binding HasDevices, Converter={StaticResource BoolToVis}}"
                              Text="右侧开关控制设备是否在任务栏和弹出面板中显示；点名称旁的铅笔可以重命名，用来区分同型号的多台设备。" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
