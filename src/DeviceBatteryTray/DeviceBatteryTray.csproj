<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DeviceBatteryTray</AssemblyName>
    <RootNamespace>DeviceBatteryTray</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- 发布版本号由 CI 从 git tag（vX.Y.Z）传入 -p:Version=X.Y.Z；本地编译用这里的前缀 -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <Product>设备电量</Product>
    <Description>在 Windows 任务栏上显示无线外设电量</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
</Project>
