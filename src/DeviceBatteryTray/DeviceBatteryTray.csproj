<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DeviceBatteryTray</AssemblyName>
    <RootNamespace>DeviceBatteryTray</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- 发布版本号由 CI 从 git tag（vX.Y.Z）传入 -p:Version=X.Y.Z；本地编译用这里的前缀 -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <Product>设备电量</Product>
    <!-- 文件说明：Win10 的通知来源、任务管理器里显示的就是它（默认是程序集名 DeviceBatteryTray） -->
    <AssemblyTitle>设备电量</AssemblyTitle>
    <Description>在 Windows 任务栏上显示无线外设电量</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- 启用 WPF 后 SDK 会把 System.IO 从隐式 using 里去掉（避免与 Shapes.Path 冲突），这里加回来 -->
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>
</Project>
